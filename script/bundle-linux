#!/usr/bin/env bash

set -euxo pipefail

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz for Linux.

Options:
  -h, --help     Display this help and exit.
  --flatpak      Set FANTA_BUNDLE_TYPE=flatpak so that this can be included in system info
  "
}

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export FANTA_BUNDLE_TYPE=flatpak
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

export FANTA_BUNDLE=true

channel="${FANTA_RELEASE_CHANNEL:-$(<crates/fanta/RELEASE_CHANNEL)}"
case "$channel" in
    dev|nightly|preview|stable) ;;
    *)
        echo "Unsupported release channel: $channel"
        exit 1
        ;;
esac
# release_channel compiles FANTA_RELEASE_CHANNEL in, so the updater polls the channel this bundle
# is for. The fanta build script picks the window icon from RELEASE_CHANNEL.
export FANTA_RELEASE_CHANNEL="${channel}"
export RELEASE_CHANNEL="${channel}"

target_dir="${CARGO_TARGET_DIR:-target}"

version="$(script/get-crate-version fanta)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
release_dir="${target_dir}/${target_triple}/release"

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

export CC=${CC:-$(which clang)}

# Build binary in release mode
# We need lld to link libwebrtc.a successfully on aarch64-linux.
# NOTE: Since RUSTFLAGS env var overrides all .cargo/config.toml rustflags
# (see https://github.com/rust-lang/cargo/issues/5376), the
# [target.aarch64-unknown-linux-gnu] section in config.toml has no effect here.
if [[ "$(uname -m)" == "aarch64" ]]; then
    export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-fuse-ld=lld -C link-args=-Wl,--disable-new-dtags,-rpath,\$ORIGIN/../lib"
else
    export RUSTFLAGS="${RUSTFLAGS:-} -C link-args=-Wl,--disable-new-dtags,-rpath,\$ORIGIN/../lib"
fi
cargo build --locked --release --target "${target_triple}" --package fanta --package cli

# Upload debug info to sentry.io
if ! command -v sentry-cli >/dev/null 2>&1; then
    echo "sentry-cli not found. skipping sentry upload."
    echo "install with: 'curl -sL https://sentry.io/get-cli | bash'"
else
    if [[ -n "${SENTRY_AUTH_TOKEN:-}" ]]; then
        echo "Uploading fanta debug symbols to sentry..."
        # note: this uploads the unstripped binary which is needed because it contains
        # .eh_frame data for stack unwinding. see https://github.com/getsentry/symbolic/issues/783
        for attempt in 1 2 3; do
            echo "Attempting sentry upload (attempt $attempt/3)..."
            if sentry-cli debug-files upload --include-sources --wait -p fanta -o fanta-dev \
                "${release_dir}/fanta"; then
                echo "Sentry upload successful on attempt $attempt"
                break
            else
                echo "Sentry upload failed on attempt $attempt"
                if [ $attempt -eq 3 ]; then
                    echo "All sentry upload attempts failed"
                fi
            fi
        done
    else
        echo "missing SENTRY_AUTH_TOKEN. skipping sentry upload."
    fi
fi

# Move the debug info into fanta.dbg, which ships separately from the tarball, and leave a
# debuglink to it in the binary.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
llvm-objcopy --only-keep-debug "${release_dir}/fanta" "${release_dir}/fanta.dbg"
llvm-objcopy --strip-debug --add-gnu-debuglink="${release_dir}/fanta.dbg" "${release_dir}/fanta"
llvm-objcopy --strip-debug "${release_dir}/cli"

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory.
temp_dir=$(mktemp -d)
fanta_dir="${temp_dir}/fanta$suffix.app"

# Binary
mkdir -p "${fanta_dir}/bin" "${fanta_dir}/libexec"
cp "${release_dir}/fanta" "${fanta_dir}/libexec/fanta-editor"
cp "${release_dir}/cli" "${fanta_dir}/bin/fanta"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
find_libs() {
    ldd "${release_dir}/fanta" |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)'
}

mkdir -p "${fanta_dir}/lib"
cp $(find_libs) "${fanta_dir}/lib"

# Icons
mkdir -p "${fanta_dir}/share/icons/hicolor/512x512/apps"
cp "crates/fanta/resources/app-icon$suffix.png" "${fanta_dir}/share/icons/hicolor/512x512/apps/fanta.png"
mkdir -p "${fanta_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/fanta/resources/app-icon$suffix@2x.png" "${fanta_dir}/share/icons/hicolor/1024x1024/apps/fanta.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="fanta"
export APP_ICON="fanta"
export APP_ARGS="%U"
if [[ "$channel" == "preview" ]]; then
  export APP_NAME="Fanta Preview"
  APP_ID="dev.fanta.Fanta-Preview"
elif [[ "$channel" == "nightly" ]]; then
  export APP_NAME="Fanta Nightly"
  APP_ID="dev.fanta.Fanta-Nightly"
elif [[ "$channel" == "dev" ]]; then
  export APP_NAME="Fanta Devel"
  APP_ID="dev.fanta.Fanta-Dev"
else
  export APP_NAME="Fanta"
  APP_ID="dev.fanta.Fanta"
fi

mkdir -p "${fanta_dir}/share/applications"
envsubst < "crates/fanta/resources/fanta.desktop.in" > "${fanta_dir}/share/applications/$APP_ID.desktop"
chmod +x "${fanta_dir}/share/applications/$APP_ID.desktop"

# The .fnx and .fig types the desktop entry opens. script/install.sh registers them.
mkdir -p "${fanta_dir}/share/mime/packages"
cp "crates/fanta/resources/fanta-mime.xml" "${fanta_dir}/share/mime/packages/$APP_ID.xml"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${fanta_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="fanta-linux-${arch}.tar.gz"

remove_match="fanta(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czf "${target_dir}/release/$archive" -C "${temp_dir}" "fanta$suffix.app"
