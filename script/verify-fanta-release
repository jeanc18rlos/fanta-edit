#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: script/verify-fanta-release [--list] [--stage NAME] [--output-dir PATH]

Runs the engine, render, import, source-order, editor, workspace, ui, shell,
release-blockers, build, and lint stages.
Use --stage more than once to select stages; --list prints commands without running.
The render stage holds the golden image test, whose baseline was rendered on macOS.
The shell stage tests the inherited crates the app relies on; release-blockers runs
the agent request-limit, output-limit, compaction and Settings regressions and
their default-feature lint. Off macOS, a step whose tests exist only on macOS is
skipped with a note.
The optional visual stage requires a macOS desktop and compares UI component images.
The optional import-preservation stage requires FANTA_FIG_FIXTURE and fails on
reported node-structure loss; it does not establish visual or override fidelity.
Logs and results.tsv are written below target/release-verification by default.

This does not validate an installer, operate the full app UI, contact production
services, or run ignored benchmarks or network tests. Private Figma fixtures run
only when import-preservation is explicitly selected.
EOF
}

list_only=false
selected_stages=()
output_directory=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --list)
            list_only=true
            shift
            ;;
        --stage|--output-dir)
            if [[ $# -lt 2 || -z "$2" ]]; then
                usage >&2
                exit 2
            fi
            if [[ "$1" == --stage ]]; then
                case "$2" in
                    engine|render|import|import-preservation|source-order|editor|workspace|ui|shell|release-blockers|build|lint|visual)
                        if [[ " ${selected_stages[*]-} " == *" $2 "* ]]; then
                            printf 'Stage selected more than once: %s\n' "$2" >&2
                            exit 2
                        fi
                        selected_stages+=("$2")
                        ;;
                    *)
                        printf 'Unknown stage: %s\n' "$2" >&2
                        exit 2
                        ;;
                esac
            else
                output_directory="$2"
            fi
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ ${#selected_stages[@]} -eq 0 ]]; then
    selected_stages=(engine render import source-order editor workspace ui shell release-blockers build lint)
fi

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"
cargo_binary="${CARGO:-cargo}"
overall_status=0

if [[ "$list_only" == false ]]; then
    # Baseline regeneration would turn a visual regression into a passing check.
    if [[ -n ${FANTA_REGEN_GOLDEN+x} || -n ${UPDATE_BASELINE+x} || -n ${UPDATE_BASELINES+x} ]]; then
        printf 'Unset FANTA_REGEN_GOLDEN, UPDATE_BASELINE and UPDATE_BASELINES before verification.\n' >&2
        exit 2
    fi
    if [[ -z "$output_directory" ]]; then
        output_directory="target/release-verification/$(date -u +%Y%m%dT%H%M%SZ)-$$"
    fi
    mkdir -p "$output_directory"
    output_directory="$(cd "$output_directory" && pwd)"
    if [[ -e "$output_directory/results.tsv" ]]; then
        printf 'Existing results at %s; choose a new output directory.\n' "$output_directory" >&2
        exit 2
    fi
    printf 'stage\tresult\texit_code\tseconds\tlog\n' > "$output_directory/results.tsv"
    {
        printf 'Started (UTC): %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'Revision: '
        git rev-parse HEAD
        printf 'Working tree:\n'
        git status --short
        uname -a
        rustc --version
        printf 'Stages: %s\n' "${selected_stages[*]}"
        printf 'Scope: automated local suites only; private fixtures require the explicit import-preservation stage.\n'
    } > "$output_directory/environment.txt"
    printf 'Verification results: %s\n' "$output_directory"
fi

run_stage() {
    local stage="$1"
    shift
    printf '%s:' "$stage"
    printf ' %q' "$@"
    printf '\n'
    if [[ "$list_only" == true ]]; then
        return
    fi
    local log_path="$output_directory/$stage.log"
    local started=$SECONDS
    local status=0
    local pipeline_status
    set +e
    "$@" 2>&1 | tee "$log_path"
    pipeline_status=("${PIPESTATUS[@]}")
    set -e
    if [[ ${pipeline_status[0]} -ne 0 ]]; then
        status=${pipeline_status[0]}
    elif [[ ${pipeline_status[1]} -ne 0 ]]; then
        status=${pipeline_status[1]}
    fi
    local result=PASS
    if [[ "$status" -ne 0 ]]; then
        result=FAIL
        overall_status=1
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$stage" "$result" "$status" "$((SECONDS - started))" "$log_path" \
        >> "$output_directory/results.tsv"
    printf '%s %s\n' "$result" "$stage"
    if [[ "$status" -eq 130 || "$status" -eq 143 ]]; then
        exit "$status"
    fi
}

# A name filter that matches only #[cfg(target_os = "macos")] tests runs zero
# tests elsewhere and exits 0, which would read as a pass.
run_macos_stage() {
    if [[ "$list_only" == false && "$(uname -s)" != Darwin ]]; then
        printf 'SKIP %s: its tests are compiled only on macOS.\n' "$1"
        return
    fi
    run_stage "$@"
}

check_project_checker_dependencies() {
    local dependencies
    dependencies="$("$cargo_binary" tree --locked -p fanta-format -e normal --prefix none)" || return 1
    if grep -E '^(gpui|skia-safe|skia-bindings|fig_viewer) ' <<< "$dependencies"; then
        echo 'fanta-check must build without GPUI, Skia or the editor (spec 0009 R9)' >&2
        return 1
    fi
}

for stage in "${selected_stages[@]}"; do
    case "$stage" in
        engine)
            run_stage "$stage" "$cargo_binary" test --locked \
                -p fanta-bundle -p fanta-doc -p fanta-fnx -p fanta-format -p fanta-canvas \
                -p fanta-tools -p fanta-present -p fanta-text \
                -p fanta-design-ops -p fanta-headless -p fanta-api -p fanta-engine
            ;;
        render)
            run_stage "$stage" "$cargo_binary" test --locked -p fanta-render
            ;;
        import)
            # Spectrum integration binaries return success without a fixture;
            # keep those opt-in checks separate from reproducible synthetic tests.
            run_stage "$stage" "$cargo_binary" test --locked -p fanta-fig-interop --lib
            ;;
        import-preservation)
            run_stage "$stage" "$cargo_binary" test --locked -p fanta-fig-interop --lib \
                imports_real_fig_fixture_without_node_structure_loss -- --ignored --nocapture
            ;;
        source-order)
            run_stage "$stage" "$cargo_binary" test --locked \
                -p fanta-bundle -p fanta-fnx -p fanta-format --lib --features serde_json/preserve_order
            ;;
        editor)
            run_stage "$stage" "$cargo_binary" test --locked -p fig_viewer --lib --example drag_bench
            ;;
        workspace)
            run_stage "$stage" "$cargo_binary" test --locked -p workspace --lib
            ;;
        ui)
            run_stage "$stage" "$cargo_binary" test --locked -p fanta_ui --lib --features test-support
            ;;
        shell)
            run_macos_stage shell-bundled-git "$cargo_binary" test --locked -p git --lib bundled_git_
            run_stage shell-languages "$cargo_binary" test --locked -p fanta_languages --lib
            run_stage shell-ai-provider-authentication "$cargo_binary" test --locked \
                -p language_model -p language_models --lib
            run_stage shell-browser-sign-in "$cargo_binary" test --locked -p client --lib test_browser_sign_in
            run_stage shell-media-server-account "$cargo_binary" test --locked \
                -p project --lib --test integration test_fanta_mcp
            run_stage shell-save-as-prompts "$cargo_binary" test --locked -p open_path_prompt --lib save_as_
            # ADR 0017 relies on these: update signatures, the signer's test
            # vector and version ordering.
            run_stage shell-update-verification "$cargo_binary" test --locked -p auto_update --lib
            run_stage shell-agent-panel-toggle "$cargo_binary" test --locked -p agent_ui --lib \
                test_toggle_closes_visible_agent_panel_when_center_pane_has_focus
            run_stage shell-design-specs "$cargo_binary" test --locked -p agent --lib test_fanta_specs
            run_stage shell-design-progress "$cargo_binary" test --locked -p agent --lib test_design_progress
            run_stage shell-design-source "$cargo_binary" test --locked \
                -p fanta-bundle -p fanta-fnx -p fanta-format --lib
            run_stage shell-hostile-edit-corpus "$cargo_binary" test --locked -p fanta-format --test check_corpus
            run_stage shell-checker-dependencies check_project_checker_dependencies
            run_stage shell-sidebar "$cargo_binary" test --locked -p sidebar --lib
            ;;
        release-blockers)
            run_stage release-blockers-agent "$cargo_binary" test --locked -p agent --lib test_turn_request_budget_
            run_stage release-blockers-acp-thread "$cargo_binary" test --locked \
                -p acp_thread --lib test_turn_request_budget_
            run_macos_stage release-blockers-settings-window "$cargo_binary" test --locked \
                -p fanta --bin fanta settings_window_
            run_stage release-blockers-output-limit "$cargo_binary" test --locked -p agent --lib test_output_limit_
            run_stage release-blockers-compaction "$cargo_binary" test --locked -p agent --lib test_compaction_
            run_stage release-blockers-manual-compaction-cancel "$cargo_binary" test --locked \
                -p agent --lib test_manual_compact_cancelled_leaves_no_marker
            run_stage release-blockers-acp-stale-cancel "$cargo_binary" test --locked \
                -p acp_thread --lib test_stale_cancelled_response_does_not_cancel_current_compaction
            run_stage release-blockers-acp-max-tokens "$cargo_binary" test --locked \
                -p acp_thread --lib test_max_tokens_cancels_pending_session_elicitation
            run_stage release-blockers-default-clippy env FANTA_CLIPPY_DEFAULT_FEATURES=1 \
                ./script/clippy --locked -p agent -p acp_thread -p language_model -p fanta
            ;;
        build)
            run_stage "$stage" "$cargo_binary" check --locked -p fanta -p cli
            ;;
        lint)
            run_stage "$stage" ./script/clippy --locked \
                -p fanta-bundle -p fanta-doc -p fanta-fnx -p fanta-format -p fanta-canvas \
                -p fanta-tools -p fanta-render -p fanta-fig-interop \
                -p fanta-present -p fanta-text -p fanta-design-ops -p fanta-headless \
                -p fanta-api -p fanta-engine -p fig_viewer -p workspace -p fanta_ui
            run_stage lint-default env FANTA_CLIPPY_DEFAULT_FEATURES=1 \
                ./script/clippy --locked -p fanta-format -p fig_viewer -p fs
            # The browser engine compiles a configuration no native lint
            # reaches: fanta-headless without rendering, fanta-format without
            # the filesystem.
            run_stage lint-wasm env RUSTFLAGS='--cfg getrandom_backend="wasm_js"' \
                "$cargo_binary" clippy --locked -p fanta-wasm-engine \
                --target wasm32-unknown-unknown --release -- --deny warnings
            ;;
        visual)
            if [[ "$list_only" == false && "$(uname -s)" != Darwin ]]; then
                printf 'The visual stage requires macOS.\n' >&2
                exit 2
            fi
            run_stage "$stage" "$cargo_binary" run --locked -p fanta_ui \
                --features visual-tests --bin fanta_ui_visual_test_runner
            ;;
    esac
done

if [[ "$list_only" == false ]]; then
    printf 'Results: %s/results.tsv\n' "$output_directory"
    printf 'Installer, full-app pointer journeys, live services and performance gates remain separate.\n'
fi
exit "$overall_status"
