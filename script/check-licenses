#!/usr/bin/env bash

set -euo pipefail

check_manifest_for_agpl () {
    local cargo_toml="$1"

    if grep -Eiq '(agpl|affero)' "$cargo_toml"; then
        echo "Error: $cargo_toml references an AGPL license. First-party crates must use LICENSE-GPL or LICENSE-APACHE."
        exit 1
    fi

    if grep -Eiq '^[[:space:]]*license-file[[:space:]]*=' "$cargo_toml"; then
        echo "Error: $cargo_toml uses license-file. First-party crates must declare LICENSE-GPL or LICENSE-APACHE via the license field and symlink."
        exit 1
    fi
}

check_no_agpl_license_file () {
    if [[ -e "LICENSE-AGPL" || -L "LICENSE-AGPL" ]]; then
        echo "Error: LICENSE-AGPL exists. First-party code must use LICENSE-GPL or LICENSE-APACHE."
        exit 1
    fi

    while IFS= read -r -d '' license_file; do
        if [[ -e "$license_file" || -L "$license_file" ]]; then
            echo "Error: $license_file exists. First-party crates must use LICENSE-GPL or LICENSE-APACHE."
            exit 1
        fi
    done < <(git ls-files -z -- "*/LICENSE-AGPL")
}

check_symlink_target () {
    local symlink_path="$1"
    local license_name="$2"

    local target=$(readlink "$symlink_path")

    local dir=$(dirname "$symlink_path")
    local depth=$(echo "$dir" | tr '/' '\n' | wc -l)
    local expected_prefix=""
    for ((i = 0; i < depth; i++)); do
        expected_prefix="../$expected_prefix"
    done
    local expected_target="${expected_prefix}${license_name}"

    if [[ "$target" != "$expected_target" ]]; then
        echo "Error: $symlink_path points to '$target' but should point to '$expected_target'"
        exit 1
    fi

    if [[ ! -e "$symlink_path" ]]; then
        echo "Error: $symlink_path is a broken symlink (target '$target' does not exist)"
        exit 1
    fi
}

check_license () {
    local dir="$1"
    local allowed_licenses=("LICENSE-GPL" "LICENSE-APACHE")

    for license in "${allowed_licenses[@]}"; do
        if [[ -L "$dir/$license" ]]; then
            check_symlink_target "$dir/$license" "$license"
            return 0
        elif [[ -e "$dir/$license" ]]; then
            echo "Error: $dir/$license exists but is not a symlink."
            exit 1
        fi
    done

    echo "Error: $dir does not contain a LICENSE-GPL or LICENSE-APACHE symlink"
    exit 1
}

check_vendored_skia_license () {
    python3 - <<'PYTHON'
import hashlib
from pathlib import Path
import tomllib

root = Path("vendor/skia-bindings-0.153.3")
manifest = tomllib.loads((root / "Cargo.toml").read_text())
if manifest["package"]["license"] != "MIT":
    raise SystemExit("Vendored skia-bindings must retain its original MIT license declaration")
expected = "4b33ed5b329a3a79eb1243fd91373c68b0ae0b9df7503bfc50d0c5253adf1b9a"
if hashlib.sha256((root / "LICENSE").read_bytes()).hexdigest() != expected:
    raise SystemExit("Vendored skia-bindings LICENSE differs from the original upstream bytes")
PYTHON
}

# ADR 0026: the engine group of layers.toml is Apache-2.0. Runs its own
# self-test first, on a temporary tree.
check_engine_licenses () {
    python3 - <<'PYTHON'
import tempfile
import tomllib
from pathlib import Path

# Still GPL: the founder's decision on its Spectrum golden fixtures is open
# (spec 0002, T2). Delete the entry in the change that relicenses the crate.
HELD_BACK = {"fanta-fig-interop"}


def problems(root):
    layers = tomllib.loads((root / "docs/architecture/layers.toml").read_text())["layer"]
    engine = sorted(name for layer in layers if layer["group"] == "engine" for name in layer["crates"])
    found = []
    for name in engine:
        directory = root / "crates" / name
        license = tomllib.loads((directory / "Cargo.toml").read_text())["package"].get("license")
        if name in HELD_BACK:
            if license == "Apache-2.0":
                found.append(f"{name} is Apache-2.0 now: remove it from HELD_BACK in script/check-licenses")
        elif license != "Apache-2.0":
            found.append(f'{name} is in the engine group and must say license = "Apache-2.0" (ADR 0026)')
        elif not (directory / "LICENSE-APACHE").is_symlink() or (directory / "LICENSE-GPL").is_symlink():
            found.append(f"{name} must link LICENSE-APACHE and not LICENSE-GPL (ADR 0026)")
    return found


def self_test():
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        (root / "docs/architecture").mkdir(parents=True)
        (root / "docs/architecture/layers.toml").write_text(
            '[[layer]]\ngroup = "engine"\ncrates = ["good", "gpl", "inherits", "unlinked", "fanta-fig-interop"]\n'
            '[[layer]]\ngroup = "shell"\ncrates = "rest"\n'
        )
        crates = {
            "good": ('"Apache-2.0"', "LICENSE-APACHE"),
            "gpl": ('"GPL-3.0-or-later"', "LICENSE-GPL"),
            "inherits": ("{ workspace = true }", "LICENSE-APACHE"),
            "unlinked": ('"Apache-2.0"', "LICENSE-GPL"),
            "fanta-fig-interop": ("{ workspace = true }", "LICENSE-GPL"),
        }
        for name, (license, link) in crates.items():
            (root / "crates" / name).mkdir(parents=True)
            (root / "crates" / name / "Cargo.toml").write_text(f"[package]\nlicense = {license}\n")
            (root / "crates" / name / link).symlink_to(f"../../{link}")
        flagged = [problem.split()[0] for problem in problems(root)]
        assert flagged == ["gpl", "inherits", "unlinked"], flagged
        (root / "crates/fanta-fig-interop/Cargo.toml").write_text('[package]\nlicense = "Apache-2.0"\n')
        assert "fanta-fig-interop" in [problem.split()[0] for problem in problems(root)]


self_test()
found = problems(Path("."))
if found:
    raise SystemExit("\n".join(f"Error: {problem}" for problem in found))
PYTHON
}

check_no_agpl_license_file
check_engine_licenses

git ls-files -z -- "Cargo.toml" "**/Cargo.toml" | while IFS= read -r -d '' cargo_toml; do
    [[ -f "$cargo_toml" ]] || continue
    check_manifest_for_agpl "$cargo_toml"

    if [[ "$cargo_toml" == "vendor/skia-bindings-0.153.3/Cargo.toml" ]]; then
        check_vendored_skia_license
        continue
    fi

    if [[ "$cargo_toml" == */Cargo.toml ]]; then
        check_license "$(dirname "$cargo_toml")"
    fi
done

echo "check-licenses succeeded"
