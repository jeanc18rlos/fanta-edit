#!/usr/bin/env python3
"""Serve a Fanta project folder with the write channel the emitted editor
needs (spec 0008 T3).

    script/serve-project <project-dir> [--port 8080] [--engine <pkg-dir>]

GET serves the project's own files, exactly as any static server would, so
`index.html` works unchanged, except that `.git/`, `.fanta/`, links that
leave the project and folder listings answer 404.
On top of that:

- `/__fanta/capabilities` answers `{"write": true, "engine": <bool>,
  "live": <bool>, "stamp": <latest change>}`; the emitted `editor.js`
  enables edit mode only when this endpoint exists, so a plain static host
  stays view-only.
- `PUT /<project-relative-path>` writes a file atomically inside the project
  (and only inside it). The editor saves every file the engine re-emits.
- `POST /__fanta/ops` forwards a `{"ops": [...], "label": ...}` batch to the
  running Fanta app's live MCP server when the app has this project open
  (spec 0008 R6/T6), so edits appear in the app instead of racing its
  reconciliation; it answers 409 when no live app matches, and the editor
  falls back to its own engine and PUT writes.
- `/__fanta/files` lists the project's files, so the engine can load them.
- `--engine` serves a `wasm-pack --target web` build of `fanta-wasm-engine`
  at `/__fanta/engine/`, keeping WebAssembly out of the project tree. Build:
      RUSTFLAGS='--cfg getrandom_backend="wasm_js"' wasm-pack build \
          crates/fanta-wasm-engine --target web --no-typescript --release

Local development only: binds 127.0.0.1 and holds no authentication. A web
page in the same browser can still send requests here, so every request must
name this server in `Host` (a page that re-points its own domain at 127.0.0.1
does not), and a write must come from a page this server served.
"""

import argparse
import json
import os
import socket
import sys
import tempfile
import time
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

SKIPPED_DIRECTORIES = {".git", ".fanta", "exports", "previews", "node_modules"}
# Never served: git's own data and the snapshot store hold every past version
# of the project, and no page needs them.
PRIVATE_DIRECTORIES = {".git", ".fanta"}
MAX_PUT_BYTES = 64 * 1024 * 1024
LIVE_CACHE_SECONDS = 5.0
INITIALIZE_PARAMS = {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": {"name": "serve-project", "version": "1.0"},
}


def discovery_file() -> Path:
    """Where the running app advertises its live MCP socket."""
    custom = os.environ.get("FANTA_USER_DATA_DIR", "").strip()
    if custom:
        return Path(custom) / "fanta_live_mcp.json"
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "Fanta" / "fanta_live_mcp.json"
    base = os.environ.get("XDG_DATA_HOME", "").strip()
    root = Path(base) if base else Path.home() / ".local" / "share"
    return root / "fanta" / "fanta_live_mcp.json"


def live_socket_path():
    try:
        record = json.loads(discovery_file().read_text())
        pid = int(record["pid"])
        path = record["socket"]
    except (OSError, ValueError, KeyError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return path


def live_calls(path, calls):
    """Send newline-delimited JSON-RPC calls over the app's Unix socket.

    `calls` holds `(method, params, is_notification)`; returns the non-
    notification results in order and raises on any error answer.
    """
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(20)
        connection.connect(path)
        reader = connection.makefile("r", encoding="utf-8", newline="\n")
        results = []
        request_id = 0
        for method, params, is_notification in calls:
            message = {"jsonrpc": "2.0", "method": method, "params": params}
            if not is_notification:
                request_id += 1
                message["id"] = request_id
            connection.sendall((json.dumps(message) + "\n").encode())
            if is_notification:
                continue
            while True:
                line = reader.readline()
                if not line:
                    raise RuntimeError("the live server closed the connection")
                answer = json.loads(line)
                if answer.get("id") != request_id:
                    continue  # a server notification; not ours
                if "error" in answer:
                    raise RuntimeError(answer["error"].get("message", "live server error"))
                results.append(answer["result"])
                break
        return results


def tool_json(result):
    """The JSON a tool result's first text content carries."""
    return json.loads(result["content"][0]["text"])


def call_live_tool(path, name, arguments):
    results = live_calls(
        path,
        [
            ("initialize", INITIALIZE_PARAMS, False),
            ("notifications/initialized", {}, True),
            ("tools/call", {"name": name, "arguments": arguments}, False),
        ],
    )
    return tool_json(results[1])


def project_files(root: Path):
    files = []
    stamp = 0
    for directory, directory_names, file_names in os.walk(root):
        directory_names[:] = sorted(
            name for name in directory_names if name not in SKIPPED_DIRECTORIES
        )
        for name in sorted(file_names):
            path = Path(directory) / name
            try:
                stamp = max(stamp, path.stat().st_mtime_ns)
            except OSError:
                continue
            files.append(path.relative_to(root).as_posix())
    return files, stamp


def contained(root: Path, relative: str, refused=SKIPPED_DIRECTORIES):
    """The absolute path for a request path, or None when it escapes the
    project, through a link too, or enters a `refused` directory."""
    candidate = (root / relative.lstrip("/")).resolve()
    root = root.resolve()
    if candidate == root or root not in candidate.parents:
        return None
    # Lower case: macOS and Windows open `.GIT` as `.git`.
    if any(part.lower() in refused for part in candidate.relative_to(root).parts):
        return None
    return candidate


class Handler(SimpleHTTPRequestHandler):
    # Set by serve(): project root and optional engine package directory.
    project: Path
    engine: Path | None
    # (expiry, socket path or None): whether the running app has THIS
    # project open, probed at most every LIVE_CACHE_SECONDS.
    live_cache: tuple[float, str | None] = (0.0, None)

    @classmethod
    def live_app(cls):
        now = time.monotonic()
        expires, cached = cls.live_cache
        if now < expires:
            return cached
        matched = None
        path = live_socket_path()
        if path:
            try:
                state = call_live_tool(path, "get_editor_state", {})
                root = state.get("project_root", "")
                if root and Path(root).resolve() == cls.project.resolve():
                    matched = path
            except (OSError, RuntimeError, ValueError, KeyError, IndexError):
                matched = None
        cls.live_cache = (now + LIVE_CACHE_SECONDS, matched)
        return matched

    def local_names(self):
        port = self.server.server_address[1]
        names = {f"127.0.0.1:{port}", f"localhost:{port}"}
        if port == 80:
            names |= {"127.0.0.1", "localhost"}
        return names

    def parse_request(self):
        if not super().parse_request():
            return False
        if self.headers.get("Host", "").lower() not in self.local_names():
            self.send_error(HTTPStatus.FORBIDDEN, "this server answers on loopback only")
            return False
        return True

    def cross_site(self):
        """Whether a write comes from a page this server did not serve.

        Browsers send `Origin` with every POST and PUT a page makes; other
        clients (curl, scripts) send none.
        """
        origin = self.headers.get("Origin")
        if origin is None:
            return False
        return origin.lower() not in {f"http://{name}" for name in self.local_names()}

    def send_head(self):
        """The static file for GET and HEAD, unless it is private."""
        relative = os.path.relpath(self.translate_path(self.path), self.directory)
        # A folder address is answered with its index file, which may be a link.
        for opened in (relative, f"{relative}/index.html", f"{relative}/index.htm"):
            if opened != "." and contained(self.project, opened, PRIVATE_DIRECTORIES) is None:
                self.send_error(HTTPStatus.NOT_FOUND, "File not found")
                return None
        return super().send_head()

    def list_directory(self, path):
        # A listing would name `.git` and `.fanta`, and no page asks for one.
        self.send_error(HTTPStatus.NOT_FOUND, "File not found")
        return None

    def send_json(self, value):
        body = json.dumps(value).encode()
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/__fanta/capabilities":
            _, stamp = project_files(self.project)
            self.send_json(
                {
                    "write": True,
                    "engine": self.engine is not None,
                    "live": self.live_app() is not None,
                    "stamp": stamp,
                }
            )
            return
        if path == "/__fanta/files":
            files, stamp = project_files(self.project)
            self.send_json({"files": files, "stamp": stamp})
            return
        if path.startswith("/__fanta/engine/"):
            if self.engine is None:
                self.send_error(HTTPStatus.NOT_FOUND)
                return
            name = path.removeprefix("/__fanta/engine/")
            file = (self.engine / name).resolve()
            if self.engine.resolve() not in file.parents or not file.is_file():
                self.send_error(HTTPStatus.NOT_FOUND)
                return
            body = file.read_bytes()
            self.send_response(HTTPStatus.OK)
            content_type = (
                "application/wasm" if name.endswith(".wasm") else "text/javascript"
            )
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().do_GET()

    def do_POST(self):
        if self.path.split("?", 1)[0] != "/__fanta/ops":
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        if self.cross_site():
            self.send_error(HTTPStatus.FORBIDDEN, "cross-site request")
            return
        # A page on another site can send a form or plain text without the
        # browser asking this server first, but not this content type.
        if self.headers.get_content_type() != "application/json":
            self.send_error(HTTPStatus.UNSUPPORTED_MEDIA_TYPE, "expected application/json")
            return
        length = int(self.headers.get("Content-Length", -1))
        if length < 0 or length > MAX_PUT_BYTES:
            self.send_error(HTTPStatus.BAD_REQUEST, "missing or oversized body")
            return
        try:
            batch = json.loads(self.rfile.read(length))
            operations = batch["ops"]
        except (ValueError, KeyError, TypeError):
            self.send_error(HTTPStatus.BAD_REQUEST, "expected a JSON body with ops")
            return
        live = self.live_app()
        if live is None:
            self.send_error(HTTPStatus.CONFLICT, "no running app has this project open")
            return
        arguments = {"ops": operations}
        if isinstance(batch.get("label"), str):
            arguments["label"] = batch["label"]
        try:
            result = call_live_tool(live, "batch_design", arguments)
        except (OSError, RuntimeError, ValueError, KeyError, IndexError) as error:
            # The next capabilities probe re-checks the app.
            type(self).live_cache = (0.0, None)
            self.send_error(HTTPStatus.BAD_GATEWAY, f"the live app refused the edit: {error}")
            return
        self.send_json(result)

    def do_PUT(self):
        if self.cross_site():
            self.send_error(HTTPStatus.FORBIDDEN, "cross-site request")
            return
        target = contained(self.project, self.path.split("?", 1)[0])
        if target is None:
            self.send_error(HTTPStatus.FORBIDDEN, "outside the project")
            return
        length = int(self.headers.get("Content-Length", -1))
        if length < 0 or length > MAX_PUT_BYTES:
            self.send_error(HTTPStatus.BAD_REQUEST, "missing or oversized body")
            return
        body = self.rfile.read(length)
        target.parent.mkdir(parents=True, exist_ok=True)
        descriptor, staged = tempfile.mkstemp(
            dir=target.parent, prefix=f".{target.name}."
        )
        try:
            with os.fdopen(descriptor, "wb") as file:
                file.write(body)
            os.replace(staged, target)
        except OSError:
            try:
                os.unlink(staged)
            except OSError:
                pass
            raise
        self.send_response(HTTPStatus.NO_CONTENT)
        self.end_headers()

    def log_message(self, format, *args):  # noqa: A002 - stdlib signature
        if "__fanta/capabilities" not in str(args[0] if args else ""):
            super().log_message(format, *args)


def make_server(project: Path, port: int, engine: Path | None):
    handler = type(
        "ProjectHandler",
        (Handler,),
        {"project": project, "engine": engine},
    )
    handler.directory = str(project)

    def factory(*arguments, **keywords):
        return handler(*arguments, directory=str(project), **keywords)

    return ThreadingHTTPServer(("127.0.0.1", port), factory)


def serve(project: Path, port: int, engine: Path | None):
    server = make_server(project, port, engine)
    print(f"serving {project} at http://127.0.0.1:{server.server_address[1]}/")
    if engine is not None:
        print(f"engine: {engine} at /__fanta/engine/")
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("project", type=Path)
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--engine", type=Path, default=None)
    arguments = parser.parse_args()
    project = arguments.project.resolve()
    if not (project / "fanta.json").is_file():
        parser.error(f"{project} holds no fanta.json; is it a Fanta project?")
    engine = arguments.engine.resolve() if arguments.engine else None
    if engine is not None and not (engine / "fanta_wasm_engine.js").is_file():
        parser.error(f"{engine} holds no fanta_wasm_engine.js wasm-pack build")
    try:
        serve(project, arguments.port, engine)
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
