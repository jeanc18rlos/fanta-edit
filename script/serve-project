#!/usr/bin/env python3
"""Serve a Fanta project folder with the write channel the emitted editor
needs (spec 0008 T3).

    script/serve-project <project-dir> [--port 8080] [--engine <pkg-dir>]

GET serves the project's own files, exactly as any static server would, so
`index.html` works unchanged. On top of that:

- `/__fanta/capabilities` answers `{"write": true, "engine": <bool>,
  "stamp": <latest change>}`; the emitted `editor.js` enables edit mode only
  when this endpoint exists, so a plain static host stays view-only.
- `PUT /<project-relative-path>` writes a file atomically inside the project
  (and only inside it). The editor saves every file the engine re-emits.
- `/__fanta/files` lists the project's files, so the engine can load them.
- `--engine` serves a `wasm-pack --target web` build of `fanta-wasm-engine`
  at `/__fanta/engine/`, keeping WebAssembly out of the project tree. Build:
      RUSTFLAGS='--cfg getrandom_backend="wasm_js"' wasm-pack build \
          crates/fanta-wasm-engine --target web --no-typescript --release

Local development only: binds 127.0.0.1 and holds no authentication.
"""

import argparse
import json
import os
import sys
import tempfile
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

SKIPPED_DIRECTORIES = {".git", "exports", "previews", "node_modules"}
MAX_PUT_BYTES = 64 * 1024 * 1024


def project_files(root: Path):
    files = []
    stamp = 0
    for directory, directory_names, file_names in os.walk(root):
        directory_names[:] = sorted(
            name for name in directory_names if name not in SKIPPED_DIRECTORIES
        )
        for name in sorted(file_names):
            path = Path(directory) / name
            try:
                stamp = max(stamp, path.stat().st_mtime_ns)
            except OSError:
                continue
            files.append(path.relative_to(root).as_posix())
    return files, stamp


def contained(root: Path, relative: str):
    """The absolute path for a request path, or None when it escapes."""
    candidate = (root / relative.lstrip("/")).resolve()
    root = root.resolve()
    if candidate == root or root not in candidate.parents:
        return None
    if any(part in SKIPPED_DIRECTORIES for part in candidate.relative_to(root).parts):
        return None
    return candidate


class Handler(SimpleHTTPRequestHandler):
    # Set by serve(): project root and optional engine package directory.
    project: Path
    engine: Path | None

    def send_json(self, value):
        body = json.dumps(value).encode()
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/__fanta/capabilities":
            _, stamp = project_files(self.project)
            self.send_json(
                {"write": True, "engine": self.engine is not None, "stamp": stamp}
            )
            return
        if path == "/__fanta/files":
            files, stamp = project_files(self.project)
            self.send_json({"files": files, "stamp": stamp})
            return
        if path.startswith("/__fanta/engine/"):
            if self.engine is None:
                self.send_error(HTTPStatus.NOT_FOUND)
                return
            name = path.removeprefix("/__fanta/engine/")
            file = (self.engine / name).resolve()
            if self.engine.resolve() not in file.parents or not file.is_file():
                self.send_error(HTTPStatus.NOT_FOUND)
                return
            body = file.read_bytes()
            self.send_response(HTTPStatus.OK)
            content_type = (
                "application/wasm" if name.endswith(".wasm") else "text/javascript"
            )
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().do_GET()

    def do_PUT(self):
        target = contained(self.project, self.path.split("?", 1)[0])
        if target is None:
            self.send_error(HTTPStatus.FORBIDDEN, "outside the project")
            return
        length = int(self.headers.get("Content-Length", -1))
        if length < 0 or length > MAX_PUT_BYTES:
            self.send_error(HTTPStatus.BAD_REQUEST, "missing or oversized body")
            return
        body = self.rfile.read(length)
        target.parent.mkdir(parents=True, exist_ok=True)
        descriptor, staged = tempfile.mkstemp(
            dir=target.parent, prefix=f".{target.name}."
        )
        try:
            with os.fdopen(descriptor, "wb") as file:
                file.write(body)
            os.replace(staged, target)
        except OSError:
            try:
                os.unlink(staged)
            except OSError:
                pass
            raise
        self.send_response(HTTPStatus.NO_CONTENT)
        self.end_headers()

    def log_message(self, format, *args):  # noqa: A002 - stdlib signature
        if "__fanta/capabilities" not in (args[0] if args else ""):
            super().log_message(format, *args)


def serve(project: Path, port: int, engine: Path | None):
    handler = type(
        "ProjectHandler",
        (Handler,),
        {"project": project, "engine": engine},
    )
    handler.directory = str(project)

    def factory(*arguments, **keywords):
        return handler(*arguments, directory=str(project), **keywords)

    server = ThreadingHTTPServer(("127.0.0.1", port), factory)
    print(f"serving {project} at http://127.0.0.1:{server.server_address[1]}/")
    if engine is not None:
        print(f"engine: {engine} at /__fanta/engine/")
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("project", type=Path)
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--engine", type=Path, default=None)
    arguments = parser.parse_args()
    project = arguments.project.resolve()
    if not (project / "fanta.json").is_file():
        parser.error(f"{project} holds no fanta.json; is it a Fanta project?")
    engine = arguments.engine.resolve() if arguments.engine else None
    if engine is not None and not (engine / "fanta_wasm_engine.js").is_file():
        parser.error(f"{engine} holds no fanta_wasm_engine.js wasm-pack build")
    try:
        serve(project, arguments.port, engine)
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
