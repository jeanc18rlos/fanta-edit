#!/usr/bin/env python3
"""Keep Fanta's architecture map, its dependency rules and its records in step with the code.

    script/architecture check              fail when a crate dependency breaks the layer map
    script/architecture map [--check]      regenerate docs/architecture/crate-map.md
    script/architecture index [--check]    validate ADRs and specs and regenerate their indexes
    script/architecture new adr TITLE      create the next decision record from its template
    script/architecture new spec TITLE     create the next spec folder from its templates
    script/architecture verify             check, map --check and index --check (what CI runs)

The layer map is docs/architecture/layers.toml. `check`, `map` and `verify`
read the workspace with `cargo metadata --no-deps`, which needs no build;
`--metadata FILE` reads saved output instead. With `--check`, `map` and
`index` change nothing and fail when a generated file is stale.

Exit code is 0 when everything holds, 1 when a rule or a record is broken and 2
when the inputs cannot be read.
"""

import argparse
import dataclasses
import datetime
import fnmatch
import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LAYERS_FILE = Path('docs/architecture/layers.toml')
CRATE_MAP_FILE = Path('docs/architecture/crate-map.md')
DECISIONS_DIRECTORY = Path('docs/decisions')
SPECS_DIRECTORY = Path('specs')

DECISION_STATUSES = ('proposed', 'accepted', 'rejected', 'deprecated', 'superseded')
SPEC_STATUSES = ('draft', 'accepted', 'in-progress', 'implemented', 'abandoned')
DECISION_KEYS = {
    'status', 'date', 'recorded', 'decision-makers', 'consulted', 'informed',
    'supersedes', 'superseded-by', 'tags',
}
SPEC_KEYS = {'status', 'date', 'owner', 'decisions', 'repositories', 'tags'}
LIST_KEYS = {'supersedes', 'tags', 'decisions', 'repositories', 'consulted', 'informed'}
RECORD_NAME = re.compile(r'^(\d{4})-([a-z0-9]+(?:-[a-z0-9]+)*)$')
GENERATED_NOTICE = 'Generated by `script/architecture map` from [`layers.toml`](layers.toml). Do not edit by hand.'


class InputError(Exception):
    pass


@dataclasses.dataclass
class Dependency:
    name: str
    kind: str
    workspace: bool


@dataclasses.dataclass
class Crate:
    name: str
    directory: str
    description: str
    license: str
    dependencies: list


@dataclasses.dataclass
class Group:
    id: str
    title: str
    summary: str
    dev_dependencies: str
    forbid: list


@dataclasses.dataclass
class Layer:
    id: str
    group: str
    title: str
    role: str
    summary: str
    crates: list
    rest: bool
    may_use: list
    forbid: list


@dataclasses.dataclass
class Seam:
    source: str
    target: str
    reason: str


@dataclasses.dataclass
class External:
    id: str
    title: str
    summary: str
    packages: list

    def matches(self, package):
        return any(fnmatch.fnmatchcase(package, pattern) for pattern in self.packages)


@dataclasses.dataclass
class Architecture:
    groups: list
    layers: list
    seams: list
    externals: list

    def group(self, group_id):
        return next(group for group in self.groups if group.id == group_id)

    def layer(self, layer_id):
        return next(layer for layer in self.layers if layer.id == layer_id)

    def external(self, external_id):
        return next(external for external in self.externals if external.id == external_id)


@dataclasses.dataclass
class Workspace:
    crates: dict

    def workspace_dependencies(self, name, kinds):
        return sorted({
            dependency.name for dependency in self.crates[name].dependencies
            if dependency.workspace and dependency.kind in kinds and dependency.name in self.crates
        })


# ---------------------------------------------------------------------------
# Reading the workspace and the layer map


def run_cargo_metadata(root):
    command = ['cargo', 'metadata', '--format-version', '1', '--no-deps']
    try:
        completed = subprocess.run(command, cwd=root, capture_output=True, text=True, check=False)
    except FileNotFoundError as error:
        raise InputError(f'cannot run cargo: {error}') from error
    if completed.returncode != 0:
        raise InputError(f'`{" ".join(command)}` failed:\n{completed.stderr.strip()}')
    return json.loads(completed.stdout)


def load_workspace(metadata, root):
    members = set(metadata['workspace_members'])
    crates = {}
    packages = [package for package in metadata['packages'] if package['id'] in members]
    member_names = {package['name'] for package in packages}
    for package in packages:
        manifest = Path(package['manifest_path']).resolve()
        try:
            directory = manifest.parent.relative_to(root.resolve()).as_posix()
        except ValueError:
            directory = manifest.parent.as_posix()
        dependencies = [
            Dependency(
                name=dependency['name'],
                kind=dependency['kind'] or 'normal',
                workspace=bool(dependency.get('path')) and dependency['name'] in member_names,
            )
            for dependency in package['dependencies']
        ]
        crates[package['name']] = Crate(
            name=package['name'],
            directory=directory,
            description=' '.join((package.get('description') or '').split()),
            license=package.get('license') or '',
            dependencies=dependencies,
        )
    return Workspace(crates)


def load_architecture(text):
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise InputError(f'{LAYERS_FILE}: {error}') from error
    try:
        groups = [
            Group(
                id=entry['id'],
                title=entry['title'],
                summary=entry.get('summary', ''),
                dev_dependencies=entry.get('dev_dependencies', 'any'),
                forbid=list(entry.get('forbid', [])),
            )
            for entry in data.get('group', [])
        ]
        layers = []
        for entry in data.get('layer', []):
            crates = entry.get('crates', [])
            layers.append(Layer(
                id=entry['id'],
                group=entry['group'],
                title=entry['title'],
                role=entry.get('role', ''),
                summary=entry.get('summary', ''),
                crates=[] if crates == 'rest' else list(crates),
                rest=crates == 'rest',
                may_use=list(entry.get('may_use', [])),
                forbid=list(entry.get('forbid', [])),
            ))
        seams = [
            Seam(source=entry['from'], target=entry['to'], reason=entry['reason'])
            for entry in data.get('seam', [])
        ]
        externals = [
            External(
                id=entry['id'],
                title=entry['title'],
                summary=entry.get('summary', ''),
                packages=list(entry['packages']),
            )
            for entry in data.get('external', [])
        ]
    except KeyError as error:
        raise InputError(f'{LAYERS_FILE}: an entry is missing the {error} key') from error
    return Architecture(groups, layers, seams, externals)


def validate_architecture(architecture):
    problems = []
    group_ids = [group.id for group in architecture.groups]
    layer_ids = [layer.id for layer in architecture.layers]
    external_ids = [external.id for external in architecture.externals]
    for kind, ids in (('group', group_ids), ('layer', layer_ids), ('external', external_ids)):
        for duplicate in sorted({value for value in ids if ids.count(value) > 1}):
            problems.append(f'{LAYERS_FILE}: {kind} "{duplicate}" is defined twice')
    for group in architecture.groups:
        if group.dev_dependencies not in ('any', 'group'):
            problems.append(f'{LAYERS_FILE}: group "{group.id}" has dev_dependencies "{group.dev_dependencies}"; use "any" or "group"')
        for external_id in group.forbid:
            if external_id not in external_ids:
                problems.append(f'{LAYERS_FILE}: group "{group.id}" forbids unknown external "{external_id}"')
    for layer in architecture.layers:
        if layer.group not in group_ids:
            problems.append(f'{LAYERS_FILE}: layer "{layer.id}" names unknown group "{layer.group}"')
        for used in layer.may_use:
            if used not in layer_ids:
                problems.append(f'{LAYERS_FILE}: layer "{layer.id}" may_use unknown layer "{used}"')
        for external_id in layer.forbid:
            if external_id not in external_ids:
                problems.append(f'{LAYERS_FILE}: layer "{layer.id}" forbids unknown external "{external_id}"')
    rest_layers = [layer.id for layer in architecture.layers if layer.rest]
    if len(rest_layers) > 1:
        problems.append(f'{LAYERS_FILE}: only one layer may take the rest of the crates; found {", ".join(rest_layers)}')
    return problems


def assign_layers(architecture, workspace):
    """Return ({crate: layer id}, problems)."""
    problems = []
    assignment = {}
    for layer in architecture.layers:
        if layer.id in workspace.crates:
            problems.append(
                f'{LAYERS_FILE}: layer "{layer.id}" has the name of a workspace crate; '
                'seams could not tell them apart, so rename the layer'
            )
        for name in layer.crates:
            if name not in workspace.crates:
                problems.append(f'{LAYERS_FILE}: layer "{layer.id}" lists "{name}", which is not a workspace crate')
            elif name in assignment:
                problems.append(f'{LAYERS_FILE}: "{name}" is listed in layers "{assignment[name]}" and "{layer.id}"')
            else:
                assignment[name] = layer.id
    rest = next((layer for layer in architecture.layers if layer.rest), None)
    for name in sorted(workspace.crates):
        if name in assignment:
            continue
        if rest is None:
            problems.append(f'{LAYERS_FILE}: workspace crate "{name}" is in no layer')
        else:
            assignment[name] = rest.id
    return assignment, problems


def reachable_layers(architecture, layer_id):
    allowed = {layer_id}
    pending = [layer_id]
    while pending:
        for used in architecture.layer(pending.pop()).may_use:
            if used not in allowed:
                allowed.add(used)
                pending.append(used)
    return allowed


def matches_endpoint(endpoint, crate, layer):
    return endpoint in (crate, layer)


def find_seam(architecture, source, source_layer, target, target_layer):
    for seam in architecture.seams:
        if matches_endpoint(seam.source, source, source_layer) and matches_endpoint(seam.target, target, target_layer):
            return seam
    return None


def production_closure(workspace, name):
    """Every workspace crate that `name` reaches through normal and build dependencies."""
    seen = set()
    pending = [name]
    while pending:
        current = pending.pop()
        for dependency in workspace.workspace_dependencies(current, ('normal', 'build')):
            if dependency not in seen:
                seen.add(dependency)
                pending.append(dependency)
    return seen


def dependency_path(workspace, start, goal):
    """A shortest normal/build path of crate names from start to goal."""
    previous = {start: None}
    queue = [start]
    while queue:
        current = queue.pop(0)
        if current == goal:
            path = []
            while current is not None:
                path.append(current)
                current = previous[current]
            return list(reversed(path))
        for dependency in workspace.workspace_dependencies(current, ('normal', 'build')):
            if dependency not in previous:
                previous[dependency] = current
                queue.append(dependency)
    return [start, goal]


def check_architecture(architecture, workspace):
    """Return a list of human-readable violations."""
    problems = validate_architecture(architecture)
    if problems:
        return problems
    assignment, problems = assign_layers(architecture, workspace)
    if problems:
        return problems
    allowed = {layer.id: reachable_layers(architecture, layer.id) for layer in architecture.layers}
    used_seams = set()

    for name in sorted(workspace.crates):
        crate = workspace.crates[name]
        layer = architecture.layer(assignment[name])
        group = architecture.group(layer.group)
        if not layer.rest and not crate.description:
            problems.append(
                f'{name}: add a `description` to {crate.directory}/Cargo.toml; '
                'the crate map uses it to say what the crate is for'
            )
        for dependency in sorted(crate.dependencies, key=lambda dependency: (dependency.name, dependency.kind)):
            if not dependency.workspace:
                continue
            target_layer = architecture.layer(assignment[dependency.name])
            if target_layer.id in allowed[layer.id]:
                continue
            seam = find_seam(architecture, name, layer.id, dependency.name, target_layer.id)
            if seam is not None:
                used_seams.add(id(seam))
                continue
            if dependency.kind == 'dev':
                if group.dev_dependencies == 'any':
                    continue
                if target_layer.group == group.id:
                    continue
                problems.append(
                    f'{name} ({layer.id}) has a dev-dependency on {dependency.name} ({target_layer.id}), '
                    f'outside the {group.id} group; {group.title} tests must build from the group alone'
                )
                continue
            problems.append(
                f'{name} ({layer.id}) depends on {dependency.name} ({target_layer.id}); '
                f'layer "{layer.id}" may use only {", ".join(sorted(allowed[layer.id]))}. '
                'Move the code, depend on an inner layer, or record a seam in '
                f'{LAYERS_FILE} with an ADR'
            )

    for name in sorted(workspace.crates):
        layer = architecture.layer(assignment[name])
        group = architecture.group(layer.group)
        forbidden = [architecture.external(external_id) for external_id in sorted(set(layer.forbid) | set(group.forbid))]
        if not forbidden:
            continue
        reach = [name] + sorted(production_closure(workspace, name))
        for external in forbidden:
            for carrier in reach:
                hits = sorted({
                    dependency.name for dependency in workspace.crates[carrier].dependencies
                    if not dependency.workspace and dependency.kind in ('normal', 'build') and external.matches(dependency.name)
                })
                if hits:
                    path = ' -> '.join(dependency_path(workspace, name, carrier) + [hits[0]])
                    problems.append(
                        f'{name} ({layer.id}) must not reach {external.title}, but does: {path}'
                    )
                    break
            if group.dev_dependencies == 'group' and external.id in group.forbid:
                hits = sorted({
                    dependency.name for dependency in workspace.crates[name].dependencies
                    if not dependency.workspace and dependency.kind == 'dev' and external.matches(dependency.name)
                })
                if hits:
                    problems.append(
                        f'{name} ({layer.id}) has a dev-dependency on {hits[0]}; '
                        f'{group.title} tests must build without {external.title}'
                    )

    for seam in architecture.seams:
        if id(seam) not in used_seams:
            problems.append(
                f'{LAYERS_FILE}: the seam {seam.source} -> {seam.target} is no longer used; delete it'
            )
    return problems


# ---------------------------------------------------------------------------
# Drawing the crate map


def mermaid_id(prefix, name):
    return prefix + re.sub(r'[^A-Za-z0-9]', '_', name)


def transitive_reduction(edges):
    """Drop an edge a -> b when another path from a already reaches b."""
    successors = {}
    for source, target in edges:
        successors.setdefault(source, set()).add(target)

    def reaches(start, goal, skipped_edge):
        seen = set()
        pending = [start]
        while pending:
            current = pending.pop()
            for successor in successors.get(current, ()):
                if (current, successor) == skipped_edge:
                    continue
                if successor == goal:
                    return True
                if successor not in seen:
                    seen.add(successor)
                    pending.append(successor)
        return False

    return sorted(edge for edge in edges if not reaches(edge[0], edge[1], edge))


def ordered_crates(architecture, assignment, layer_id):
    return sorted(name for name, assigned in assignment.items() if assigned == layer_id)


def endpoint_layer(architecture, assignment, endpoint):
    if any(layer.id == endpoint for layer in architecture.layers):
        return endpoint
    return assignment[endpoint]


def render_layer_diagram(architecture, assignment):
    lines = ['```mermaid', 'flowchart TD']
    for group in architecture.groups:
        layers = [layer for layer in architecture.layers if layer.group == group.id]
        if not layers:
            continue
        lines.append(f'  subgraph {mermaid_id("group_", group.id)}["{group.title}"]')
        for layer in layers:
            lines.append(f'    {mermaid_id("layer_", layer.id)}["{layer.title}<br/>({layer.role})"]')
        lines.append('  end')
    for layer in architecture.layers:
        for used in layer.may_use:
            lines.append(f'  {mermaid_id("layer_", layer.id)} --> {mermaid_id("layer_", used)}')
    seam_edges = sorted({
        (endpoint_layer(architecture, assignment, seam.source), endpoint_layer(architecture, assignment, seam.target))
        for seam in architecture.seams
    })
    for source, target in seam_edges:
        lines.append(f'  {mermaid_id("layer_", source)} -. seam .-> {mermaid_id("layer_", target)}')
    lines.append('```')
    return lines


def render_crate_diagram(architecture, workspace, assignment):
    rest_layers = {layer.id for layer in architecture.layers if layer.rest}
    shown = sorted(name for name, layer_id in assignment.items() if layer_id not in rest_layers)
    shown_set = set(shown)
    rest_node = 'rest_crates'
    rest_count = len(workspace.crates) - len(shown)

    internal_edges = set()
    rest_edges = set()
    for name in sorted(workspace.crates):
        for dependency in workspace.workspace_dependencies(name, ('normal', 'build')):
            if name in shown_set and dependency in shown_set:
                internal_edges.add((name, dependency))
            elif name in shown_set:
                rest_edges.add((mermaid_id('crate_', name), rest_node))
            elif dependency in shown_set:
                rest_edges.add((rest_node, mermaid_id('crate_', dependency)))

    external_edges = set()
    for name in sorted(workspace.crates):
        source = mermaid_id('crate_', name) if name in shown_set else rest_node
        for dependency in workspace.crates[name].dependencies:
            if dependency.workspace or dependency.kind not in ('normal', 'build'):
                continue
            for external in architecture.externals:
                if external.matches(dependency.name):
                    external_edges.add((source, mermaid_id('external_', external.id)))

    lines = ['```mermaid', 'flowchart TD']
    for group in architecture.groups:
        layers = [layer for layer in architecture.layers if layer.group == group.id]
        if not layers:
            continue
        lines.append(f'  subgraph {mermaid_id("group_", group.id)}["{group.title}"]')
        for layer in layers:
            if layer.rest:
                lines.append(f'    {rest_node}[["{rest_count} {layer.title.lower()} crates"]]')
                continue
            lines.append(f'    subgraph {mermaid_id("layer_", layer.id)}["{layer.title}"]')
            for name in ordered_crates(architecture, assignment, layer.id):
                lines.append(f'      {mermaid_id("crate_", name)}["{name}"]')
            lines.append('    end')
        lines.append('  end')
    for external in architecture.externals:
        lines.append(f'  {mermaid_id("external_", external.id)}(["{external.title}"])')
    for source, target in transitive_reduction(internal_edges):
        lines.append(f'  {mermaid_id("crate_", source)} --> {mermaid_id("crate_", target)}')
    for source, target in sorted(rest_edges):
        lines.append(f'  {source} --> {target}')
    for source, target in sorted(external_edges):
        lines.append(f'  {source} -.-> {target}')
    lines.append('```')
    return lines


def markdown_cell(text):
    return text.replace('|', '\\|')


def render_crate_map(architecture, workspace, assignment):
    rest_layers = {layer.id for layer in architecture.layers if layer.rest}
    rest_title = next((layer.title.lower() for layer in architecture.layers if layer.rest), 'other')
    dependents = {name: set() for name in workspace.crates}
    for name in workspace.crates:
        for dependency in workspace.workspace_dependencies(name, ('normal', 'build')):
            dependents[dependency].add(name)

    lines = [
        '# Crate map',
        '',
        GENERATED_NOTICE,
        'The [architecture guide](README.md) explains the layers and the rules.',
        '',
        '## Layers',
        '',
        'An arrow means "may use". Use is transitive: a layer may also use what its',
        'targets may use. `script/architecture check` fails on any other dependency',
        'unless a seam below allows it.',
        '',
    ]
    lines += render_layer_diagram(architecture, assignment)
    lines += [
        '',
        '| Layer | Group | Role | Crates | What it holds |',
        '| --- | --- | --- | --- | --- |',
    ]
    for layer in architecture.layers:
        crates = ordered_crates(architecture, assignment, layer.id)
        listed = f'{len(crates)} crates' if layer.rest else ', '.join(f'`{name}`' for name in crates)
        lines.append(
            f'| {layer.title} | {architecture.group(layer.group).title} | {layer.role} | {listed} | {markdown_cell(layer.summary)} |'
        )
    lines += [
        '',
        '## Crates',
        '',
        'Solid arrows are normal and build dependencies, reduced: an arrow is left',
        'out when a longer path already connects the two crates. Dotted arrows lead',
        'to external package families. The table lists every direct dependency.',
        '',
    ]
    lines += render_crate_diagram(architecture, workspace, assignment)
    lines += [
        '',
        '| Crate | Layer | Description | Depends on | Used by |',
        '| --- | --- | --- | --- | --- |',
    ]
    for layer in architecture.layers:
        if layer.rest:
            continue
        for name in ordered_crates(architecture, assignment, layer.id):
            crate = workspace.crates[name]
            depends_on = ', '.join(
                f'`{dependency}`' for dependency in workspace.workspace_dependencies(name, ('normal', 'build'))
                if assignment[dependency] not in rest_layers
            )
            rest_dependencies = [
                dependency for dependency in workspace.workspace_dependencies(name, ('normal', 'build'))
                if assignment[dependency] in rest_layers
            ]
            if rest_dependencies:
                suffix = f'{len(rest_dependencies)} {rest_title} crates'
                depends_on = f'{depends_on}, {suffix}' if depends_on else suffix
            used_by = ', '.join(
                f'`{dependent}`' for dependent in sorted(dependents[name]) if assignment[dependent] not in rest_layers
            )
            rest_dependents = [dependent for dependent in dependents[name] if assignment[dependent] in rest_layers]
            if rest_dependents:
                suffix = f'{rest_title}: ' + ', '.join(f'`{dependent}`' for dependent in sorted(rest_dependents))
                used_by = f'{used_by}; {suffix}' if used_by else suffix
            lines.append(
                f'| [`{name}`](../../{crate.directory}) | {layer.title} | {markdown_cell(crate.description)} '
                f'| {depends_on or "—"} | {used_by or "—"} |'
            )
    lines += ['', '## Seams', '']
    if architecture.seams:
        lines += [
            'Dependencies the layers would refuse, allowed on purpose.',
            '',
            '| From | To | Why |',
            '| --- | --- | --- |',
        ]
        for seam in architecture.seams:
            lines.append(f'| `{seam.source}` | `{seam.target}` | {markdown_cell(seam.reason)} |')
    else:
        lines.append('None.')
    lines += ['', '## External package families', '']
    for external in architecture.externals:
        users = sorted({
            name for name in workspace.crates
            if assignment[name] not in rest_layers and any(
                not dependency.workspace and dependency.kind in ('normal', 'build') and external.matches(dependency.name)
                for dependency in workspace.crates[name].dependencies
            )
        })
        forbidden_in = [layer.title for layer in architecture.layers if external.id in layer.forbid]
        forbidden_in += [group.title + ' group' for group in architecture.groups if external.id in group.forbid]
        lines.append(f'- **{external.title}** ({", ".join(f"`{package}`" for package in external.packages)}): {external.summary}')
        lines.append(f'  - Used directly by: {", ".join(f"`{name}`" for name in users) or "no mapped crate"}.')
        if forbidden_in:
            lines.append(f'  - Forbidden in: {", ".join(forbidden_in)}.')
    lines.append('')
    return '\n'.join(lines)


# ---------------------------------------------------------------------------
# Decision records and specs


@dataclasses.dataclass
class Record:
    number: str
    slug: str
    path: Path
    title: str
    fields: dict


def parse_front_matter(text, path, allowed_keys):
    """Parse the `key: value` block between the leading `---` lines."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != '---':
        raise InputError(f'{path}: must start with a `---` front matter block')
    try:
        end = next(index for index in range(1, len(lines)) if lines[index].strip() == '---')
    except StopIteration as error:
        raise InputError(f'{path}: the front matter block is not closed with `---`') from error
    fields = {}
    for line in lines[1:end]:
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        key, separator, value = line.partition(':')
        key = key.strip()
        if not separator:
            raise InputError(f'{path}: front matter line "{line}" is not `key: value`')
        if key not in allowed_keys:
            raise InputError(f'{path}: unknown front matter key "{key}"; allowed: {", ".join(sorted(allowed_keys))}')
        value = value.strip()
        if key in LIST_KEYS:
            if not (value.startswith('[') and value.endswith(']')):
                raise InputError(f'{path}: "{key}" must be a list like [a, b]')
            fields[key] = [item.strip().strip('"\'') for item in value[1:-1].split(',') if item.strip()]
        else:
            fields[key] = value.strip('"\'')
    body = lines[end + 1:]
    title = next((line[2:].strip() for line in body if line.startswith('# ')), '')
    if not title:
        raise InputError(f'{path}: add a `# Title` heading after the front matter')
    return fields, title


def parse_date(value, path, key):
    try:
        return datetime.date.fromisoformat(value)
    except (TypeError, ValueError) as error:
        raise InputError(f'{path}: "{key}" must be a date like 2026-10-27, not "{value}"') from error


def load_decisions(root):
    directory = root / DECISIONS_DIRECTORY
    records = []
    for path in sorted(directory.glob('[0-9][0-9][0-9][0-9]-*.md')):
        match = RECORD_NAME.match(path.stem)
        if not match:
            raise InputError(f'{path.relative_to(root)}: name decision records NNNN-lowercase-words.md')
        fields, title = parse_front_matter(path.read_text(), path.relative_to(root), DECISION_KEYS)
        records.append(Record(match.group(1), match.group(2), path, title, fields))
    return records


def load_specs(root):
    directory = root / SPECS_DIRECTORY
    records = []
    for folder in sorted(path for path in directory.glob('[0-9][0-9][0-9][0-9]-*') if path.is_dir()):
        match = RECORD_NAME.match(folder.name)
        if not match:
            raise InputError(f'{folder.relative_to(root)}: name spec folders NNNN-lowercase-words')
        spec = folder / 'spec.md'
        if not spec.exists():
            raise InputError(f'{folder.relative_to(root)}: add spec.md')
        fields, title = parse_front_matter(spec.read_text(), spec.relative_to(root), SPEC_KEYS)
        records.append(Record(match.group(1), match.group(2), folder, title, fields))
    return records


def validate_decisions(decisions, root):
    problems = []
    by_number = {}
    for record in decisions:
        location = record.path.relative_to(root)
        if record.number in by_number:
            problems.append(f'{location}: number {record.number} is also used by {by_number[record.number].path.name}')
        by_number[record.number] = record
        status = record.fields.get('status')
        if status not in DECISION_STATUSES:
            problems.append(f'{location}: status must be one of {", ".join(DECISION_STATUSES)}, not "{status}"')
        if 'decision-makers' not in record.fields:
            problems.append(f'{location}: name the decision-makers')
        try:
            decided = parse_date(record.fields.get('date'), location, 'date')
            if 'recorded' in record.fields:
                recorded = parse_date(record.fields['recorded'], location, 'recorded')
                if recorded < decided:
                    problems.append(f'{location}: "recorded" ({recorded}) is earlier than "date" ({decided})')
        except InputError as error:
            problems.append(str(error))
    for record in decisions:
        location = record.path.relative_to(root)
        status = record.fields.get('status')
        successor_number = record.fields.get('superseded-by')
        if status == 'superseded' and not successor_number:
            problems.append(f'{location}: a superseded record names its successor in "superseded-by"')
        if successor_number:
            successor = by_number.get(successor_number)
            if successor is None:
                problems.append(f'{location}: "superseded-by" names {successor_number}, which does not exist')
            elif record.number not in successor.fields.get('supersedes', []):
                problems.append(f'{location}: {successor_number} must list {record.number} in "supersedes"')
            elif status != 'superseded':
                problems.append(f'{location}: names a successor, so its status is "superseded"')
            elif successor.fields.get('status') != 'accepted':
                problems.append(f'{location}: is superseded by {successor_number}, which is not accepted')
        for predecessor_number in record.fields.get('supersedes', []):
            predecessor = by_number.get(predecessor_number)
            if predecessor is None:
                problems.append(f'{location}: "supersedes" names {predecessor_number}, which does not exist')
            elif status == 'accepted' and predecessor.fields.get('superseded-by') != record.number:
                problems.append(
                    f'{location}: is accepted, so {predecessor_number} must be "superseded" with "superseded-by: {record.number}"'
                )
    return problems


def validate_specs(specs, decisions, root):
    problems = []
    decision_numbers = {record.number for record in decisions}
    numbers = {}
    for record in specs:
        location = record.path.relative_to(root)
        if record.number in numbers:
            problems.append(f'{location}: number {record.number} is also used by {numbers[record.number]}')
        numbers[record.number] = record.path.name
        status = record.fields.get('status')
        if status not in SPEC_STATUSES:
            problems.append(f'{location}/spec.md: status must be one of {", ".join(SPEC_STATUSES)}, not "{status}"')
        try:
            parse_date(record.fields.get('date'), f'{location}/spec.md', 'date')
        except InputError as error:
            problems.append(str(error))
        for number in record.fields.get('decisions', []):
            if number not in decision_numbers:
                problems.append(f'{location}/spec.md: "decisions" names {number}, which is not in {DECISIONS_DIRECTORY}')
        if status in ('accepted', 'in-progress', 'implemented'):
            for required in ('design.md', 'tasks.md'):
                if not (record.path / required).exists():
                    problems.append(f'{location}: add {required}; a spec that is {status} needs one')
        tasks = record.path / 'tasks.md'
        if status == 'implemented' and tasks.exists():
            open_tasks = [line.strip() for line in tasks.read_text().splitlines() if re.match(r'\s*[-*] \[ \]', line)]
            if open_tasks:
                problems.append(
                    f'{location}/tasks.md: an implemented spec cannot have open tasks; still open: {open_tasks[0]}'
                )
    return problems


def status_cell(record, by_number, link_prefix):
    status = record.fields.get('status', '')
    successor = record.fields.get('superseded-by')
    if successor and successor in by_number:
        return f'{status} by [{successor}]({link_prefix}{by_number[successor].path.name})'
    return status


def render_decision_index(decisions):
    by_number = {record.number: record for record in decisions}
    lines = ['| ADR | Decision | Status | Date |', '| --- | --- | --- | --- |']
    for record in decisions:
        lines.append(
            f'| [{record.number}]({record.path.name}) | {markdown_cell(record.title)} '
            f'| {status_cell(record, by_number, "")} | {record.fields.get("date", "")} |'
        )
    return '\n'.join(lines)


def render_spec_index(specs):
    lines = ['| Spec | Title | Status | Date | Decisions |', '| --- | --- | --- | --- | --- |']
    for record in specs:
        decisions = ', '.join(record.fields.get('decisions', [])) or '—'
        lines.append(
            f'| [{record.number}]({record.path.name}/spec.md) | {markdown_cell(record.title)} '
            f'| {record.fields.get("status", "")} | {record.fields.get("date", "")} | {decisions} |'
        )
    return '\n'.join(lines)


def replace_between_markers(text, name, content, path):
    start = f'<!-- {name}:start -->'
    end = f'<!-- {name}:end -->'
    if start not in text or end not in text:
        raise InputError(f'{path}: add the `{start}` and `{end}` markers around the index')
    before, rest = text.split(start, 1)
    _, after = rest.split(end, 1)
    return f'{before}{start}\n{content}\n{end}{after}'


def build_indexes(root):
    """Return ({path: new text}, problems)."""
    decisions = load_decisions(root)
    specs = load_specs(root)
    problems = validate_decisions(decisions, root) + validate_specs(specs, decisions, root)
    outputs = {}
    for relative, name, content in (
        (DECISIONS_DIRECTORY / 'README.md', 'decisions', render_decision_index(decisions)),
        (SPECS_DIRECTORY / 'README.md', 'specs', render_spec_index(specs)),
    ):
        path = root / relative
        outputs[path] = replace_between_markers(path.read_text(), name, content, relative)
    return outputs, problems


def slugify(title):
    slug = re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-')
    return '-'.join(slug.split('-')[:8]) or 'untitled'


def next_number(paths):
    numbers = [int(path.name[:4]) for path in paths if path.name[:4].isdigit()]
    return f'{max(numbers, default=0) + 1:04d}'


def fill_template(text, title, today):
    return text.replace('{{title}}', title).replace('{{date}}', today)


def create_record(root, kind, title, today):
    if kind == 'adr':
        directory = root / DECISIONS_DIRECTORY
        number = next_number(directory.glob('[0-9][0-9][0-9][0-9]-*.md'))
        path = directory / f'{number}-{slugify(title)}.md'
        template = (directory / 'template.md').read_text()
        path.write_text(fill_template(template, title, today))
        return [path]
    directory = root / SPECS_DIRECTORY
    number = next_number(path for path in directory.glob('[0-9][0-9][0-9][0-9]-*') if path.is_dir())
    folder = directory / f'{number}-{slugify(title)}'
    folder.mkdir()
    created = []
    for name in ('spec.md', 'design.md', 'tasks.md'):
        template = (directory / 'templates' / name).read_text()
        (folder / name).write_text(fill_template(template, title, today))
        created.append(folder / name)
    return created


# ---------------------------------------------------------------------------
# Commands


def read_inputs(root, metadata_file):
    if metadata_file:
        metadata = json.loads(Path(metadata_file).read_text())
    else:
        metadata = run_cargo_metadata(root)
    workspace = load_workspace(metadata, root)
    architecture = load_architecture((root / LAYERS_FILE).read_text())
    return architecture, workspace


def report(problems, success):
    for problem in problems:
        print(f'error: {problem}', file=sys.stderr)
    if problems:
        return 1
    print(success)
    return 0


def command_check(root, metadata_file):
    architecture, workspace = read_inputs(root, metadata_file)
    problems = check_architecture(architecture, workspace)
    return report(problems, f'{len(workspace.crates)} crates follow {LAYERS_FILE}.')


def write_or_compare(path, text, check, root, command):
    relative = path.relative_to(root)
    current = path.read_text() if path.exists() else None
    if current == text:
        return []
    if check:
        return [f'{relative} is stale; run `script/architecture {command}`']
    path.write_text(text)
    print(f'wrote {relative}')
    return []


def command_map(root, metadata_file, check):
    architecture, workspace = read_inputs(root, metadata_file)
    problems = validate_architecture(architecture)
    if not problems:
        assignment, problems = assign_layers(architecture, workspace)
    if problems:
        return report(problems, '')
    text = render_crate_map(architecture, workspace, assignment)
    problems = write_or_compare(root / CRATE_MAP_FILE, text, check, root, 'map')
    return report(problems, f'{CRATE_MAP_FILE} is current.')


def command_index(root, check):
    outputs, problems = build_indexes(root)
    for path, text in outputs.items():
        problems += write_or_compare(path, text, check, root, 'index')
    return report(problems, 'Decision and spec records are valid and their indexes are current.')


def command_new(root, kind, title):
    created = create_record(root, kind, title, datetime.date.today().isoformat())
    for path in created:
        print(f'created {path.relative_to(root)}')
    return command_index(root, check=False)


def command_verify(root, metadata_file):
    results = [
        command_check(root, metadata_file),
        command_map(root, metadata_file, check=True),
        command_index(root, check=True),
    ]
    return max(results)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--root', type=Path, default=ROOT, help=argparse.SUPPRESS)
    parser.add_argument('--metadata', help='read `cargo metadata --format-version 1 --no-deps` output from this file')
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('check', help='fail when a crate dependency breaks the layer map')
    map_parser = commands.add_parser('map', help='regenerate docs/architecture/crate-map.md')
    map_parser.add_argument('--check', action='store_true', help='fail instead of writing when the map is stale')
    index_parser = commands.add_parser('index', help='validate records and regenerate their indexes')
    index_parser.add_argument('--check', action='store_true', help='fail instead of writing when an index is stale')
    new_parser = commands.add_parser('new', help='create the next ADR or spec from its template')
    new_parser.add_argument('kind', choices=('adr', 'spec'))
    new_parser.add_argument('title')
    commands.add_parser('verify', help='check, map --check and index --check')
    arguments = parser.parse_args(argv)
    root = arguments.root.resolve()
    try:
        if arguments.command == 'check':
            return command_check(root, arguments.metadata)
        if arguments.command == 'map':
            return command_map(root, arguments.metadata, arguments.check)
        if arguments.command == 'index':
            return command_index(root, arguments.check)
        if arguments.command == 'new':
            return command_new(root, arguments.kind, arguments.title)
        return command_verify(root, arguments.metadata)
    except InputError as error:
        print(f'error: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
