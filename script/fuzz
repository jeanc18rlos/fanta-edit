#!/usr/bin/env bash
# Runs one fuzz target of a parser crate with the limits the nightly job uses:
#   script/fuzz <crate> <target> [seconds, default 60]
# New inputs land in the ignored fuzz/corpus; the committed seeds are only read.
set -euo pipefail

# The one place the fuzzing nightly is pinned; fuzz.yml installs what this prints.
toolchain=nightly-2026-11-12
if [[ "${1:-}" == --toolchain ]]; then
    echo "$toolchain"
    exit
fi

crate=$1
target=$2
seconds=${3:-60}
fuzz_dir="$(cd "$(dirname "$0")/.." && pwd)/crates/$crate/fuzz"
mkdir -p "$fuzz_dir/corpus/$target"
cd "$fuzz_dir/.."
exec cargo "+$toolchain" fuzz run "$target" "$fuzz_dir/corpus/$target" "$fuzz_dir/seeds/$target" -- \
    -max_total_time="$seconds" -max_len=65536 -timeout=10 -rss_limit_mb=2048
