[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=Design Editor
Comment=An agent-native design editor
TryExec=$APP_CLI
StartupNotify=$DO_STARTUP_NOTIFY
Exec=$APP_CLI $APP_ARGS
Icon=$APP_ICON
Categories=Graphics;VectorGraphics;Development;GUIDesigner;
Keywords=fanta;design;figma;fig;fnx;prototype;ui;ux;
# fanta-mime.xml defines the .fnx and .fig types.
MimeType=text/x-fanta-fnx;application/x-figma;x-scheme-handler/fanta;
Actions=NewWindow;

[Desktop Action NewWindow]
Exec=$APP_CLI --new $APP_ARGS
Name=New Window
